<Window x:Class="KuroHitsuji.PresentationWPF.Views.Collector.CollectorUnhideElementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KuroHitsuji.PresentationWPF.Views.Collector"
        mc:Ignorable="d"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Title="{Binding ToolName}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Lib/WPFStyles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="#FFF7F7F5" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFFFF"
                BorderBrush="#FFE7E5E4"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Why Not Here Results"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#FF1C1917"/>

                    <TextBlock Grid.Row="2"
                               Text="Visibility diagnostics for selected element"
                               FontSize="13"
                               Foreground="#FF78716C"/>
                </Grid>

                <Grid Grid.Column="1"
                      VerticalAlignment="Top"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel -->
            <Border Grid.Column="0"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFE7E5E4"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>


                        <!-- Diagnostics Title -->
                        <TextBlock Grid.Row="2"
                                   Text="Diagnostics"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF1C1917"/>

                        <!-- Diagnostics List -->
                        <ItemsControl Grid.Row="4"
                                      ItemsSource="{Binding DiagnosticItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="10"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{Binding IconBackground}">
                                                    <TextBlock Text="{Binding IconText}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="{Binding IconFontSize}"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding IconForeground}"/>
                                                </Border>

                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding Header}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF1C1917"/>

                                                    <TextBlock Text="{Binding Description}"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="{Binding DescriptionForeground}"/>

                                                    <TextBlock Text="{Binding Evidence}"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="#FF57534E"/>

                                                    <TextBlock Text="{Binding Recommendation}"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               Foreground="#FF44403C"/>

                                                    <TextBlock Text="{Binding FixMessage}"
                                                               Margin="0,6,0,0"
                                                               TextWrapping="Wrap"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#FF2563EB"/>

                                                    <Button Content="{Binding FixButtonText}"
                                                            Width="90"
                                                            Margin="0,10,0,0"
                                                            Style="{DynamicResource GrayRoundedButtonStyle}"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding FixButtonVisibility}"
                                                            Command="{Binding DataContext.FixCmd, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />

                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right Panel -->
            <Border Grid.Column="2"
                    Background="#FFFFFFFF"
                    BorderBrush="#FFE7E5E4"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Element Details"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF1C1917"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Element ID"
                                   FontSize="12"
                                   Foreground="#FF78716C"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ElementId}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF292524"/>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Category"
                                   FontSize="12"
                                   Foreground="#FF78716C"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ElementCategory}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF292524"/>
                    </Grid>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target View"
                                   FontSize="12"
                                   Foreground="#FF78716C"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TargetViewName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF292524"/>
                    </Grid>

                    <Grid Grid.Row="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Phase"
                                   FontSize="12"
                                   Foreground="#FF78716C"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ElementPhase}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF292524"/>
                    </Grid>

                    <Border Grid.Row="10"
                            Background="#FFF5F5F4"
                            BorderBrush="#FFE7E5E4"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Summary"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FF57534E"/>

                            <TextBlock Grid.Row="2"
                                       Text="{Binding SummaryCheck}"
                                       TextWrapping="Wrap"
                                       FontSize="13"
                                       Foreground="#FF292524"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Button Content="Close"
                    HorizontalAlignment="Right"
                    Padding="18,9"
                    Command="{Binding CloseCmd}"
                    Style="{DynamicResource CyanRoundedButtonStyle}"/>
        </Grid>
    </Grid>

</Window>
